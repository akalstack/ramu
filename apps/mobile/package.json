{
  "name": "@ramu/mobile",
  "version": "0.1.0-alpha.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "gen:assets": "node scripts/gen-assets.mjs",
    "gen:terminal": "node scripts/gen-terminal.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo run:ios",
    "build:android": "expo run:android",
    "dev:build": "expo start --dev-client",
    "dev:go": "expo start --go",
    "gen:icons": "swift scripts/gen-icons.swift"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.24",
    "@ramu/contracts": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "8.0.2",
    "expo": "~57.0.28",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-widgets": "~57.0.25",
    "highlight.js": "^11.12.0",
    "lucide-react-native": "1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
