{
  "name": "@ramu/mobile",
  "version": "0.1.0-alpha.20",
  "private": true,
  "description": "Ramu phone and tablet app for iOS and Android.",
  "license": "MIT",
  "author": "Ramu contributors",
  "homepage": "https://getramu.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akalstack/ramu.git",
    "directory": "apps/mobile"
  },
  "bugs": {
    "url": "https://github.com/akalstack/ramu/issues"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/start.mjs --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "gen:assets": "node scripts/gen-assets.mjs",
    "gen:terminal": "node scripts/gen-terminal.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo run:ios",
    "build:android": "expo run:android",
    "dev:build": "node scripts/start.mjs --dev-client",
    "dev:go": "node scripts/start.mjs --go",
    "eas:ios": "eas build --profile development --platform ios",
    "eas:android": "eas build --profile development --platform android",
    "eas:release:ios": "eas build --profile production --platform ios --auto-submit",
    "eas:release:android": "eas build --profile production --platform android --auto-submit",
    "gen:icons": "swift scripts/gen-icons.swift"
  },
  "dependencies": {
    "@bsky.app/react-native-uitextview": "2.7.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.28",
    "@legendapp/list": "3.7.3",
    "@ramu/client-runtime": "workspace:*",
    "@ramu/contracts": "workspace:*",
    "@ramu/shared": "workspace:*",
    "@react-native-menu/menu": "2.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-widgets": "~58.0.28",
    "highlight.js": "^11.12.0",
    "lucide-react-native": "1.75.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.2.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webrtc": "155.0.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "enriched-markdown": {
    "enableMath": false
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  }
}
