{
  "expo": {
    "name": "Ramu",
    "slug": "ramu",
    "scheme": "ramu",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#131315",
    "ios": {
      "bundleIdentifier": "dev.ramu.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Find Ramu hosts on your network and connect to the workspace on your paired host.",
        "NSMicrophoneUsageDescription": "Ramu records only while you dictate a message, and recognizes speech on this iPhone. Audio is never uploaded or kept.",
        "NSSpeechRecognitionUsageDescription": "Ramu turns your dictated message into text on this iPhone. Audio never leaves the device.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSBonjourServices": ["_ramu._tcp"]
      },
      "icon": "../../assets/Ramu.icon"
    },
    "android": {
      "package": "dev.ramu.mobile",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "monochromeImage": "./assets/icon-monochrome.png",
        "backgroundColor": "#232327"
      },
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.NEARBY_WIFI_DEVICES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a one-time Ramu pairing offer."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to a chat on your paired host.",
          "cameraPermission": "Take a photo to attach to a Ramu chat."
        }
      ],
      "expo-notifications",
      "./plugins/withTrustedHttp.cjs",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Ramu does not use the camera for screen video.",
          "microphonePermission": "Ramu records only while you dictate a message, and recognizes speech on this iPhone. Audio is never uploaded or kept."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-light.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#1c1c1f",
            "image": "./assets/icon-foreground.png"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "groupIdentifier": "group.dev.ramu.mobile",
          "bundleIdentifier": "dev.ramu.mobile.activities",
          "widgets": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
