{
  "name": "@ramu/server",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Ramu workspace server: agents, files, Git, terminals, schedules and the local database.",
  "type": "module",
  "bin": {
    "ramu": "dist/cli.js",
    "ramu-server": "dist/cli.js"
  },
  "exports": {
    "./build": "./src/build.ts",
    "./attachments": "./src/attachments.ts",
    "./browserFrames": "./src/browser/browserFrames.ts",
    "./browserRuntime": "./src/browser/browserRuntime.ts",
    "./browserUploads": "./src/browser/browserUploads.ts",
    "./browserDownloads": "./src/browser/browserDownloads.ts",
    "./browserBridge": "./src/browser/browserBridge.ts",
    "./browserProfiles": "./src/browser/browserProfiles.ts",
    "./browserImport": "./src/browser/browserImport.ts",
    "./browserImportSources": "./src/browser/browserImportSources.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@cursor/sdk": "1.0.37",
    "@dagrejs/dagre": "2.0.4",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "@noble/hashes": "1.8.0",
    "@opencode/client": "2.0.30",
    "chart.js": "4.6.1",
    "docx": "9.13.0",
    "editorconfig": "^3.0.2",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "lucide": "1.54.0",
    "luxon": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mediabunny": "1.64.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "node-pty": "catalog:",
    "pele": "^1.13.0",
    "playwright-core": "^1.64.0",
    "pptxgenjs": "4.0.1",
    "quickjs-emscripten-core": "0.32.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "tweetnacl": "1.0.3",
    "undici": "^7.30.1",
    "werift": "0.25.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ramu/client-runtime": "workspace:*",
    "@ramu/contracts": "workspace:*",
    "@ramu/shared": "workspace:*",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
