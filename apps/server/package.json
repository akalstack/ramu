{
  "name": "@ramu/server",
  "version": "1.1.0-beta.2",
  "private": true,
  "description": "Ramu workspace server: agents, files, Git, terminals, schedules and the local database.",
  "license": "MIT",
  "author": "Ramu contributors",
  "homepage": "https://getramu.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akalstack/ramu.git",
    "directory": "apps/server"
  },
  "bugs": {
    "url": "https://github.com/akalstack/ramu/issues"
  },
  "type": "module",
  "bin": {
    "ramu": "dist/cli.js",
    "ramu-server": "dist/cli.js"
  },
  "exports": {
    "./build": "./src/build.ts",
    "./attachments": "./src/attachments.ts",
    "./browserFrames": "./src/browser/browserFrames.ts",
    "./browserRuntime": "./src/browser/browserRuntime.ts",
    "./browserUploads": "./src/browser/browserUploads.ts",
    "./browserDownloads": "./src/browser/browserDownloads.ts",
    "./browserBridge": "./src/browser/browserBridge.ts",
    "./browserProfiles": "./src/browser/browserProfiles.ts",
    "./browserImport": "./src/browser/browserImport.ts",
    "./browserImportSources": "./src/browser/browserImportSources.ts"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@cursor/sdk": "1.4.1",
    "@dagrejs/dagre": "3.1.3",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@noble/hashes": "2.4.0",
    "@opencode/client": "2.3.2",
    "chart.js": "4.6.1",
    "docx": "9.15.4",
    "editorconfig": "^4.0.1",
    "esbuild": "0.28.2",
    "jszip": "3.10.2",
    "lucide": "1.75.0",
    "luxon": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mediabunny": "1.66.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "node-pty": "catalog:",
    "pele": "^1.13.0",
    "playwright-core": "^1.65.1",
    "pptxgenjs": "4.0.1",
    "quickjs-emscripten-core": "0.32.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "tweetnacl": "1.0.3",
    "undici": "^8.12.4",
    "werift": "0.27.0",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ramu/client-runtime": "workspace:*",
    "@ramu/contracts": "workspace:*",
    "@ramu/shared": "workspace:*",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
