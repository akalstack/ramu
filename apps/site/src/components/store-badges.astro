---
import { ANDROID_TESTERS_GROUP, ANDROID_TESTING_OPT_IN, STORES } from '@/lib/site'
---

<div class="stores">
  {
    STORES.map((store) => (
      <a class="store" href={store.href}>
        <img src={store.badge} alt={store.label} width={store.width} height="40" />
      </a>
    ))
  }
</div>
<p class="stores-android">
  Android is in closed testing. Join the <a href={ANDROID_TESTERS_GROUP}>akalstack-ramu Google Group</a>, then{' '}
  <a href={ANDROID_TESTING_OPT_IN}>become a tester on Google Play</a> with the same Google account, and install.
</p>
