---
import '@/styles/global.css'
import { Backdrop } from '@/components/backdrop'
import { Demo } from '@/components/demo'
import { ProviderLogo } from '@/components/provider-logo'
import { LinkButton } from '@/components/site-button'
import { AKALSTACK, MOBILE_SETUP, PROVIDERS, RELEASES, REPO } from '@/lib/site'

const title = 'Ramu — Describe it. Ramu puts it online.'
const description =
  'Describe an app and Ramu builds it, puts it online and keeps it working, on accounts you own. For developers: a new project, deploy, CI and previews in one flow, with the coding agents you already use. Free and open source, with an iOS and Android companion.'
const canonical = new URL('/', Astro.site)
// Shorter copy for link previews (WhatsApp, Slack, X...), which cut the description after a line or two.
const shareTitle = 'Ramu: Describe it. Ramu puts it online.'
const shareDescription =
  'Ramu builds your app, puts it online and keeps it working, on accounts you own. Free and open source, with Claude Code, Codex, Cursor and more.'
const ogImage = new URL('/og.png', Astro.site).href
const ogImageAlt = 'Ramu: Describe it. Ramu builds it, puts it online and keeps it working, on accounts you own.'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ramu',
  description,
  url: canonical.href,
  image: ogImage,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, iOS, Android',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: RELEASES,
  sameAs: [REPO],
  publisher: { '@type': 'Organization', name: 'Akalstack', url: AKALSTACK, sameAs: ['https://github.com/akalstack'] },
}

/** The person's path from an idea to a live app, as Ramu runs it today. */
const PATH = [
  {
    title: 'Say what you want',
    body: 'Type it into the same box as any task. Ramu asks at most three questions, each with a recommended answer, and proposes a stack in one line you accept or change.',
  },
  {
    title: 'Ramu makes the project',
    body: 'It runs the framework’s own generator in a new folder, commits, and gives the thread a goal: the build and tests pass and the main page loads.',
  },
  {
    title: 'Watch it take shape',
    body: 'The app opens in the browser panel as soon as it serves. Questions come as cards; anything only you know is asked once and kept with the project.',
  },
  {
    title: 'Deploy to your account',
    body: 'One sheet picks the target, signs in to your account, publishes the repository and sets the variables the app needs, with its Postgres database made on your own account too. Then it shows the live address.',
  },
  {
    title: 'Keep changing it',
    body: 'Each change arrives as a pull request with CI and a preview address. Merging deploys it, and a failed deployment wakes the thread that made it, with the build log.',
  },
]

const SAFELY = [
  'Previews deploy without asking, and CI that GitHub or GitLab requires before merging',
  'Production always asks you first, and runs your migrations before it goes out',
  'The thread hears how its push went, from the checks your Git host lists',
  'Uptime watched on the live address, with an incident thread when it goes down',
]

const PLATFORMS = ['Vercel', 'Netlify', 'Railway', 'Fly.io', 'Cloudflare', 'Supabase']

const WORK = [
  {
    title: 'Keep going through usage limits',
    body: 'Set your preferred provider order. Ramu switches with visible thread context when a limit is reached, and switches back once your first choice has room again. If all are limited, it waits and resumes when capacity returns, even after a restart.',
  },
  {
    title: 'Keep what agents make',
    body: 'Docs, diagrams, decks, dashboards, designs, motion videos and small apps open from the sidebar or your phone, with versions, editing in place (live, with someone you share it with) and exports to Word, PowerPoint, PDF and MP4.',
  },
  {
    title: 'Get another model’s perspective',
    body: 'Let your agent consult a second model for advice and review. Delegate tasks to helpers across providers, with optional isolated checkouts.',
  },
  {
    title: 'Give longer tasks a goal',
    body: 'Keep an objective moving across turns and provider changes. Pause, resume, and set continuation limits so you stay in control.',
  },
  {
    title: 'Carry knowledge between agents',
    body: 'Share project knowledge and preferences across providers. Read, edit, and restore earlier versions of your notes.',
  },
  {
    title: 'Turn finished work into lessons',
    body: 'Capture reusable skills and lessons from completed tasks. Choose automatic updates or review them first, with revision history.',
  },
  {
    title: 'Leave work running',
    body: 'Threads and terminals keep running when you close the window. Schedule recurring tasks, recover unfinished threads after a restart, and catch up with recaps.',
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#131315" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ramu" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#path">Skip to content</a>

    <header class="nav">
      <div class="nav-inner">
        <a class="nav-brand" href="#top" aria-label="Ramu home">
          <img src="/wordmark.svg" alt="Ramu" height="22" />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#path">How it works</a>
          <a href="#providers">Accounts</a>
          <a href="#work">Agents</a>
          <a href="#review">Review</a>
          <a href="#mobile">Mobile</a>
          <a href={`${REPO}#guides`}>Docs</a>
          <a class="nav-cta" href="#download">Download</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" id="top">
        <Backdrop client:idle />
        <h1>Describe it. Ramu builds it, puts it online and keeps it working.</h1>
        <p class="hero-sub">
          On accounts you own, with the coding agents you already use. When one reaches its usage limit, the next picks up
          the thread with its context, so the work doesn't stop.
        </p>
        <div class="hero-actions">
          <LinkButton tone="primary" href="#download">Get Ramu</LinkButton>
          <LinkButton href={REPO}>Read the source</LinkButton>
          <span class="hero-note">MIT licensed · Desktop + iOS and Android companion</span>
        </div>
        <Demo client:load />
      </section>

      <section class="section section-split" id="path">
        <div class="section-head sticky">
          <h2>From an idea to a live app.</h2>
          <p>
            The same path whether you have never opened a terminal or ship every day. A developer can start at any step:
            Deploy on an existing project, or Set up CI alone.
          </p>
        </div>
        <ol class="rows">
          {
            PATH.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section section-split" id="safely">
        <div class="section-head">
          <h2>Every change, safely.</h2>
          <p>
            Ramu works on a branch and opens a pull request for each change, so you see it running before anyone else
            does. Merging is what puts it live.
          </p>
        </div>
        <ul class="checks">{SAFELY.map((line) => <li>{line}</li>)}</ul>
      </section>

      <section class="section" id="providers">
        <div class="section-head">
          <h2>Your agents. Your accounts. Their official tools.</h2>
          <p>
            Ramu runs Claude Code, Codex, OpenCode, Cursor, and Antigravity through each provider's own CLI, SDK, or
            runtime, signed in with the plan or API key you already have. Your app runs on hosting and data accounts you
            own, which you can take anywhere. Ramu is free, resells nothing and runs no hosting, so each provider bills
            you exactly as before. Keys you save stay in your computer's keychain.
          </p>
        </div>
        <ul class="ingredients">
          {
            PROVIDERS.map((p) => (
              <li>
                <ProviderLogo provider={p} size={40} />
                <div>
                  <h3>{p.name}</h3>
                  <p>{p.signIn}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="section-head">
          <ul class="checks">
            <li>Through their own CLI, with your account kept on your computer: {PLATFORMS.join(', ')}</li>
          </ul>
        </div>
      </section>

      <section class="section section-split" id="work">
        <div class="section-head sticky">
          <h2>Less restarting. More finishing.</h2>
          <p>
            Keep the objective, conversation, and project knowledge together as the work continues. Your computer must
            stay awake. Provider capabilities vary.
          </p>
        </div>
        <ul class="rows">
          {
            WORK.map((w) => (
              <li>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section section-split" id="review">
        <div class="section-head">
          <h2>See what changed. Decide what stays.</h2>
          <p>
            Review recorded changes for each turn and send inline feedback to your agent. Undo selected changes with
            conflict checks to protect later edits.
          </p>
          <ul class="checks">
            <li>Monaco editor and split terminals beside the thread</li>
            <li>Branches, staging, stashes, and sync</li>
            <li>Unsent drafts kept per thread across restarts</li>
          </ul>
        </div>
        <figure class="diff" aria-label="Example diff with a review comment">
          <figcaption>
            <span>src/middleware/limit.ts</span>
            <span class="diff-stat"><b class="add">+42</b> <b class="del">−3</b></span>
          </figcaption>
          <pre><code><span class="ln ctx"><i>12</i>{'export function limit(opts: LimitOptions) {'}</span><span class="ln del"><i>13</i>{'  const windowMs = 1000'}</span><span class="ln add"><i>13</i>{'  const windowMs = opts.windowMs ?? 60_000'}</span><span class="ln add"><i>14</i>{'  const hits = new Map<string, number[]>()'}</span><span class="ln ctx"><i>15</i>{'  return async (req, res, next) => {'}</span></code></pre>
          <div class="comment">
            <b>You</b> Key by API key, not IP. Several customers share one proxy.
            <div class="comment-actions">
              <span>Sent to Codex</span>
              <span class="comment-undo" aria-hidden="true">Undo this change</span>
            </div>
          </div>
        </figure>
      </section>

      <section class="section section-split" id="mobile">
        <div class="section-head">
          <h2>Step away from your desk. Stay with the work.</h2>
          <p>
            Pair the iOS or Android companion with your computer. Follow live agent progress, send the next instruction,
            and respond when an agent needs you.
          </p>
          <LinkButton className="mt-5" href={MOBILE_SETUP}>Set up mobile</LinkButton>
        </div>
        <div class="section-head">
          <ul class="checks">
            <li>Chat, choose models, and manage goals</li>
            <li>Review diffs and send comments to your agent</li>
            <li>Stage changes, commit, and sync with Git</li>
            <li>Use live terminals and switch between paired computers</li>
          </ul>
          <p>Agents run on your computer. Keep it awake and reachable while you connect from your phone.</p>
        </div>
      </section>

      <section class="section section-split" id="source">
        <div class="section-head">
          <h2>Your workspace, open to build on.</h2>
          <p>
            MIT licensed, with a desktop app, mobile companion, and a workspace server you can run headless. Read the
            code, contribute, or make it your own.
          </p>
          <LinkButton className="mt-5" href={REPO}>Browse the source</LinkButton>
        </div>
        <div class="terminal" role="img" aria-label="Terminal commands to run Ramu from source">
          <pre><code><span class="t-dim">$ </span>git clone {REPO}.git{'\n'}<span class="t-dim">$ </span>cd ramu{'\n'}<span class="t-dim">$ </span>pnpm install --frozen-lockfile{'\n'}<span class="t-dim">$ </span>pnpm dev{'\n'}<span class="t-ok">ready</span> <span class="t-dim">Node 24, pnpm 11.21.0</span></code></pre>
        </div>
      </section>

      <section class="download" id="download">
        <div class="download-inner">
          <h2>Bring your next idea to Ramu.</h2>
          <p>
            Download the desktop alpha, connect a provider, and describe what you want, or open a repository you already
            have. Add the mobile companion to keep up from your phone.
          </p>
          <div class="hero-actions">
            <LinkButton tone="primary" href={RELEASES}>macOS (Apple silicon and Intel)</LinkButton>
            <LinkButton href={RELEASES}>Linux (x64 and arm64)</LinkButton>
            <LinkButton href={MOBILE_SETUP}>iOS and Android setup</LinkButton>
          </div>
          <p class="download-fine">
            Installers and SHA-256 checksums are on GitHub Releases. macOS builds are unsigned and not notarized; install
            alpha updates manually. Linux GUI validation is pending. Windows is experimental, with no release downloads.
            See the <a href={`${REPO}/blob/main/docs/guide/providers.md`}>provider setup guide</a>.
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <img src="/ramu-logo.svg" alt="Ramu" height="22" />
      <span>
        Made by <a href={AKALSTACK}>Akalstack</a>. MIT licensed. Provider names and logos belong to their owners.
      </span>
      <nav aria-label="Footer">
        <a href={REPO}>GitHub</a>
        <a href={RELEASES}>Releases</a>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        <a href={`${REPO}/blob/main/SECURITY.md`}>Security</a>
        <a href="https://github.com/sponsors/akalstack">Sponsor</a>
        <a href="https://trakteer.id/akalstack">Trakteer</a>
      </nav>
    </footer>
  </body>
</html>
