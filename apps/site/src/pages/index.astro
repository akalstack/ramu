---
import '@/styles/global.css'
import { Demo } from '@/components/demo'
import Icon from '@/components/icon.astro'
import { ProviderLogo } from '@/components/provider-logo'
import { LinkButton } from '@/components/site-button'
import StoreBadges from '@/components/store-badges.astro'
import { AKALSTACK, MOBILE_SETUP, PROVIDERS, RELEASES, REPO, SERVICES } from '@/lib/site'

const title = 'Ramu — Describe it. Ramu ships it.'
const description =
  'Describe an app and your coding agents build it, put it online and keep it running, on accounts you own. A new project, deploys, CI and previews in one flow, with Claude Code, Codex, Cursor and more. Free and open source, with an iOS and Android companion.'
const canonical = new URL('/', Astro.site)
// Shorter copy for link previews (WhatsApp, Slack, X...), which cut the description after a line or two.
const shareTitle = 'Ramu: Describe it. Ramu ships it.'
const shareDescription =
  'Your coding agents build the app, put it online and keep it running, on accounts you own. Free and open source, with Claude Code, Codex, Cursor and more.'
const ogImage = new URL('/og.png', Astro.site).href
const ogImageAlt = 'Ramu: Describe it. Ramu ships it.'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ramu',
  description,
  url: canonical.href,
  image: ogImage,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, iOS, Android',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: RELEASES,
  sameAs: [REPO],
  publisher: { '@type': 'Organization', name: 'Akalstack', url: AKALSTACK, sameAs: ['https://github.com/akalstack'] },
}

/** The person's path from an idea to a live app, as Ramu runs it today. */
const PATH = [
  { title: 'Say what you want', body: 'At most three questions, each with a suggested answer. Then a stack in one line.' },
  { title: 'Ramu makes the project', body: 'It runs the framework’s own generator, commits, and sets a goal: build and tests pass.' },
  { title: 'Watch it take shape', body: 'The app opens in the browser panel as soon as it runs. Questions come as cards.' },
  { title: 'Deploy to your account', body: 'Install your host’s plugin once. Production always waits for your OK. Then the live address.' },
  { title: 'Keep changing it', body: 'Each change is a pull request with CI. Merging ships it when your host deploys from the repo.' },
]

const SAFELY = [
  'Previews and CI show up as checks on the pull request',
  'Production asks you first, and runs migrations before it ships',
  'After a push, the thread hears how its checks went',
  'Uptime is watched, and an outage opens an incident thread',
]

const WHY = [
  {
    icon: 'rocket',
    title: 'One sentence to a live app',
    body: 'Ramu asks, builds until the tests pass, and deploys to your own hosting account.',
  },
  {
    icon: 'target',
    title: 'Work that finishes itself',
    body: 'Longer tasks get a goal. Ramu calls it done only when the checks really pass.',
  },
  {
    icon: 'shuffle',
    title: 'Limits don’t stop you',
    body: 'When one provider runs out, the next picks up the thread with its context.',
  },
] as const

const WORK = [
  { icon: 'moon', title: 'Leave it running', body: 'Threads, terminals and schedules keep going after you close the window. Recaps catch you up.' },
  { icon: 'users', title: 'Bring in another model', body: 'Ask a second model for a review, or hand tasks to helpers on any provider.' },
  { icon: 'brain', title: 'Memory that carries over', body: 'Notes, preferences, skills and lessons are shared by every provider.' },
  { icon: 'layers', title: 'Artifacts you keep', body: 'Apps, docs, diagrams, slides, dashboards, designs and motion. Export to Word, PowerPoint, PDF or video.' },
  { icon: 'puzzle', title: 'Plugins', body: 'One install adds a service’s skills, tools and CLI for every agent. You review it before anything installs.' },
  { icon: 'id', title: 'Identities', body: 'Work and personal Git authors and logins, picked per project, so nothing is switched by hand.' },
  { icon: 'globe', title: 'Browser and devices', body: 'Agents drive a browser, your screen, or their own iOS Simulator or Android emulator. Watch or take over.' },
  { icon: 'branch', title: 'Git, done for you', body: 'Branches, worktrees, pull requests and reviews on GitHub, GitLab, Bitbucket and Azure DevOps.' },
  { icon: 'server', title: 'Any computer', body: 'Run agents on another machine over your network, Tailscale, SSH or a tunnel, or headless on a server.' },
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#131315" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ramu" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#why">Skip to content</a>

    <header class="nav">
      <div class="nav-inner">
        <a class="nav-brand" href="#top" aria-label="Ramu home">
          <img src="/wordmark.svg" alt="Ramu" height="22" />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#why">Why Ramu</a>
          <a href="#path">How it works</a>
          <a href="#work">Features</a>
          <a href="#mobile">Mobile</a>
          <a href="/plugins">Plugins</a>
          <a href={`${REPO}/blob/main/docs/README.md#guide`}>Docs</a>
          <a class="nav-cta" href="#download">Download</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" id="top">
        <div class="sky" aria-hidden="true">
          <div class="sky-grid"></div>
          <div class="sky-beams"></div>
          <i class="sky-orb"></i>
          <i class="sky-orb"></i>
          <div class="sky-grain"></div>
        </div>
        <a class="pill" href={RELEASES}>
          <span class="pill-dot" aria-hidden="true"></span>
          Free and open source · Alpha
          <span aria-hidden="true">→</span>
        </a>
        <h1>Describe it. <span class="grad">Ramu ships it.</span></h1>
        <p class="hero-sub">
          Your coding agents build the app, put it online and keep it running. On accounts you own, free and open
          source.
        </p>
        <div class="hero-actions">
          <LinkButton tone="primary" href="#download">Download Ramu</LinkButton>
          <LinkButton href={REPO}>View on GitHub</LinkButton>
        </div>
        <div class="works-with">
          <span>Works with</span>
          <ul>
            {
              PROVIDERS.map((p) => (
                <li title={p.name}>
                  <ProviderLogo provider={p} size={28} />
                  <span>{p.name}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <Demo client:load />
      </section>

      <section class="services" aria-labelledby="services-title">
        <p id="services-title" class="services-title">Deploys with each host’s own plugin. Pull requests on your Git host.</p>
        <ul class="sr-only">{SERVICES.map((svc) => <li>{svc.name}: {svc.role}</li>)}</ul>
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {
              [...SERVICES, ...SERVICES].map((svc) => (
                <span class="service">
                  <img src={svc.logo} alt="" width="22" height="22" />
                  <span>
                    <b>{svc.name}</b>
                    <small>{svc.role}</small>
                  </span>
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="why">
        <div class="section-head center reveal">
          <span class="eyebrow">Why Ramu</span>
          <h2>Less babysitting. More shipping.</h2>
        </div>
        <ul class="why">
          {
            WHY.map((w, i) => (
              <li class="card reveal" style={`--d:${i * 90}ms`}>
                <div class={`viz viz-${i}`} aria-hidden="true">
                  {i === 0 && (
                    <>
                      <span class="viz-prompt">“A booking page for my barbershop”</span>
                      <span class="viz-arrow" />
                      <span class="viz-live">
                        <i />
                        barbershop.vercel.app
                      </span>
                    </>
                  )}
                  {i === 1 && (
                    <ul class="viz-checks">
                      <li>Build passes</li>
                      <li>12 tests pass</li>
                      <li>Changes are in the repo</li>
                      <li class="viz-done">Goal met</li>
                    </ul>
                  )}
                  {i === 2 && (
                    <div class="viz-meters">
                      <div class="vm vm-a">
                        <ProviderLogo provider={PROVIDERS[0]!} size={22} />
                        <span class="vm-track">
                          <span class="vm-fill" />
                        </span>
                        <span class="vm-tag">Limit</span>
                      </div>
                      <div class="vm vm-b">
                        <ProviderLogo provider={PROVIDERS[1]!} size={22} />
                        <span class="vm-track">
                          <span class="vm-fill" />
                        </span>
                        <span class="vm-tag">Picks up</span>
                      </div>
                    </div>
                  )}
                </div>
                <div class="card-body">
                  <span class="card-icon">
                    <Icon name={w.icon} />
                  </span>
                  <h3>{w.title}</h3>
                  <p>{w.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section section-split" id="path">
        <div class="section-head sticky reveal">
          <span class="eyebrow">How it works</span>
          <h2>From an idea to a live app.</h2>
          <p>New to code or shipping daily, it’s the same path. Developers can start at any step.</p>
        </div>
        <ol class="timeline">
          {
            PATH.map((step, i) => (
              <li class="reveal" style={`--d:${i * 70}ms`}>
                <span class="step-num">{i + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section section-split" id="safely">
        <div class="section-head reveal">
          <span class="eyebrow">Ship safely</span>
          <h2>Every change, reviewed before it’s live.</h2>
          <p>Ramu works on a branch and opens a pull request. You see it running before anyone else does.</p>
          <ul class="checks">{SAFELY.map((line) => <li>{line}</li>)}</ul>
        </div>
        <figure class="pr reveal" aria-label="Example pull request with checks and a preview">
          <figcaption>
            <span class="pr-badge">Open</span>
            <b>Add booking reminders</b>
            <span class="pr-num">#24</span>
          </figcaption>
          <ul class="pr-checks">
            <li class="ok">CI · build and test<span>Passed</span></li>
            <li class="ok">Preview deployed<span>barbershop-git-reminders.vercel.app</span></li>
            <li class="wait">Production<span>Waits for you</span></li>
          </ul>
          <div class="pr-actions">
            <span class="pr-merge">Merge…</span>
            <span class="pr-note">Production asks you first</span>
          </div>
        </figure>
      </section>

      <section class="section" id="providers">
        <div class="section-head center reveal">
          <span class="eyebrow">Your accounts</span>
          <h2>Your agents. Your accounts. Their official tools.</h2>
          <p>
            Ramu runs each agent through its own CLI or SDK, signed in with the plan you already pay for. Ramu resells
            nothing and hosts nothing. Keys stay in your keychain.
          </p>
        </div>
        <ul class="ingredients">
          {
            PROVIDERS.map((p, i) => (
              <li class="reveal" style={`--d:${i * 60}ms`}>
                <ProviderLogo provider={p} size={40} />
                <div>
                  <h3>{p.name}</h3>
                  <p>{p.signIn}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" id="work">
        <div class="section-head center reveal">
          <span class="eyebrow">Features</span>
          <h2>Everything around the agent, in one window.</h2>
          <p>Editor, terminals, Git and review beside the thread. Some features depend on the provider.</p>
        </div>
        <ul class="grid">
          {
            WORK.map((w, i) => (
              <li class="card tile reveal" style={`--d:${(i % 3) * 80}ms`}>
                <span class="card-icon">
                  <Icon name={w.icon} />
                </span>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section section-split" id="review">
        <div class="section-head reveal">
          <span class="eyebrow">Review</span>
          <h2>See what changed. Keep what you like.</h2>
          <p>Every turn’s changes are recorded. Comment inline to steer the agent, or undo just the parts you don’t want.</p>
          <ul class="checks">
            <li>Monaco editor and split terminals</li>
            <li>Branches, staging, stashes and sync</li>
            <li>Drafts saved per thread</li>
          </ul>
        </div>
        <figure class="diff reveal" aria-label="Example diff with a review comment">
          <figcaption>
            <span>src/middleware/limit.ts</span>
            <span class="diff-stat"><b class="add">+42</b> <b class="del">−3</b></span>
          </figcaption>
          <pre><code><span class="ln ctx"><i>12</i>{'export function limit(opts: LimitOptions) {'}</span><span class="ln del"><i>13</i>{'  const windowMs = 1000'}</span><span class="ln add"><i>13</i>{'  const windowMs = opts.windowMs ?? 60_000'}</span><span class="ln add"><i>14</i>{'  const hits = new Map<string, number[]>()'}</span><span class="ln ctx"><i>15</i>{'  return async (req, res, next) => {'}</span></code></pre>
          <div class="comment">
            <b>You</b> Key by API key, not IP. Several customers share one proxy.
            <div class="comment-actions">
              <span>Sent to Codex</span>
              <span class="comment-undo" aria-hidden="true">Undo this change</span>
            </div>
          </div>
        </figure>
      </section>

      <section class="section section-split" id="mobile">
        <div class="section-head reveal">
          <span class="eyebrow">Mobile</span>
          <h2>Step away. Stay with the work.</h2>
          <p>Pair the iOS or Android app with your computer. Follow progress, answer questions and approve from anywhere.</p>
          <ul class="checks">
            <li>Chat, models and goals</li>
            <li>Diffs, comments and Git</li>
            <li>Live terminals on every paired computer</li>
            <li>Push notifications when an agent needs you</li>
          </ul>
          <StoreBadges />
          <p class="stores-note">Or <a href={MOBILE_SETUP}>build it from source</a>.</p>
        </div>
        <div class="phone-wrap reveal">
          <div class="phone" aria-label="The Ramu phone app asking to approve a production deploy" role="img">
            <div class="phone-notch"></div>
            <div class="phone-head"><span>‹</span><b>Barbershop booking</b><span>⋯</span></div>
            <div class="phone-body">
              <div class="pm pm-user">Add reminder emails a day before.</div>
              <div class="pm pm-agent">Done. 14 tests pass and the preview is up.</div>
              <div class="pm-tool"><span>Run</span> pnpm test · 14 passed</div>
              <div class="pm-card">
                <b>Deploy to production?</b>
                <span>Vercel · migrations run first</span>
                <div class="pm-btns"><i>Not now</i><i class="on">Allow once</i></div>
              </div>
            </div>
            <div class="phone-compose">Message…</div>
          </div>
        </div>
      </section>

      <section class="section section-split" id="source">
        <div class="section-head reveal">
          <span class="eyebrow">Open source</span>
          <h2>Yours to read, run and change.</h2>
          <p>MIT licensed: the desktop app, the phone app, and a workspace server you can run headless.</p>
          <LinkButton className="mt-6" href={REPO}>Browse the source</LinkButton>
        </div>
        <div class="terminal reveal" role="img" aria-label="Terminal commands to run Ramu from source">
          <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <pre><code><span class="tl"><span class="t-dim">$ </span>git clone {REPO}.git</span><span class="tl"><span class="t-dim">$ </span>cd ramu</span><span class="tl"><span class="t-dim">$ </span>pnpm install --frozen-lockfile</span><span class="tl"><span class="t-dim">$ </span>pnpm dev</span><span class="tl"><span class="t-ok">ready</span> <span class="t-dim">Node 24, pnpm 11.21.0</span></span></code></pre>
        </div>
      </section>

      <section class="download" id="download">
        <div class="download-inner reveal">
          <img class="download-logo" src="/ramu-logo.svg" alt="" width="56" height="56" />
          <h2>Bring your next idea to Ramu.</h2>
          <p>Download the desktop alpha, connect a provider and say what you want.</p>
          <div class="hero-actions">
            <LinkButton tone="primary" href={RELEASES}>macOS · Apple silicon and Intel</LinkButton>
            <LinkButton href={RELEASES}>Linux · x64 and arm64</LinkButton>
          </div>
          <StoreBadges />
          <p class="download-fine">
            Installers and checksums are on GitHub Releases. Alpha builds are unsigned, so updates install by hand.
            Windows is coming. See <a href={`${REPO}/blob/main/docs/guide/providers.md`}>provider setup</a>.
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <img src="/ramu-logo.svg" alt="Ramu" height="22" />
      <span>
        Made by <a href={AKALSTACK}>Akalstack</a>. MIT licensed. Provider names and logos belong to their owners.
      </span>
      <nav aria-label="Footer">
        <a href={REPO}>GitHub</a>
        <a href={RELEASES}>Releases</a>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        <a href={`${REPO}/blob/main/SECURITY.md`}>Security</a>
        <a href={`${AKALSTACK}/privacy`}>Privacy</a>
        <a href={`${AKALSTACK}/terms`}>Terms</a>
        <a href="https://github.com/sponsors/akalstack">Sponsor</a>
        <a href="https://trakteer.id/akalstack">Trakteer</a>
      </nav>
    </footer>
    <script>
      // Fade sections in as they scroll into view. Without script or with reduced motion, everything stays visible.
      const items = document.querySelectorAll('.reveal')
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-in')
              io.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        items.forEach((el) => io.observe(el))
      }
      // The sky's loops cost frames while scrolling the rest of the page; run them only while the hero shows.
      const sky = document.querySelector('.sky')
      if (sky && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => sky.classList.toggle('is-off', !entry?.isIntersecting)).observe(sky)
      }
    </script>
  </body>
</html>
