// Deploy with `pnpm --filter @ramu/link deploy` after creating the D1 database and setting the secrets listed in
// apps/link/README.md. Everything here runs on the Workers free plan.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ramu-link",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ramu-link",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "HostRelay" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostRelay"] }],
  "vars": {
    // Links per account while the service sells nothing; 0 removes the limit. Selling Plus (the PADDLE_* secrets in
    // README.md) replaces it with the Free and Plus limits.
    "HOST_LIMIT": "0",
    // "sandbox" while testing checkout against Paddle's sandbox.
    "PADDLE_ENV": "production",
  },
}
