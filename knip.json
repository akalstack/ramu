{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreBinaries": ["swift"],
      "ignoreDependencies": ["node-pty"],
      "ignoreUnresolved": ["\\.\\./apps/mobile/src/runtime/transport\\.ts"]
    },
    "apps/desktop": {
      "entry": ["forge.config.cjs", "src/preload/*.ts"],
      "ignoreDependencies": [
        "@agentclientprotocol/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@modelcontextprotocol/sdk",
        "editorconfig",
        "luxon",
        "node-pty",
        "zod",
        "@electron-forge/*",
        "@ramu/web",
        "babel-plugin-react-compiler"
      ]
    },
    "apps/mobile": {
      "ignoreDependencies": ["expo-updates"],
      "entry": ["plugins/*.cjs"]
    },
    "apps/server": {
      "ignoreBinaries": ["rtk"]
    }
  }
}
