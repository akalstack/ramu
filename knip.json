{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreBinaries": ["swift"],
      "ignoreDependencies": ["node-pty"]
    },
    "apps/desktop": {
      "entry": ["forge.config.cjs", "src/preload/*.ts"],
      "ignoreDependencies": [
        "@agentclientprotocol/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@cursor/sdk",
        "@opencode/client",
        "@modelcontextprotocol/sdk",
        "editorconfig",
        "luxon",
        "node-pty",
        "playwright-core",
        "zod",
        "@electron-forge/*",
        "@ramu/web",
        "babel-plugin-react-compiler"
      ]
    },
    "apps/mobile": {
      "ignoreDependencies": ["expo-updates"],
      "entry": ["plugins/*.cjs"]
    }
  },
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"]
  }
}
