{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreBinaries": ["swift"],
      "ignoreDependencies": ["node-pty"]
    },
    "apps/desktop": {
      "entry": ["forge.config.cjs", "src/preload/*.ts"],
      "ignoreDependencies": [
        "@agentclientprotocol/sdk",
        "@anthropic-ai/claude-agent-sdk",
        "@cursor/sdk",
        "@opencode/client",
        "@modelcontextprotocol/sdk",
        "@napi-rs/keyring",
        "editorconfig",
        "luxon",
        "node-pty",
        "playwright-core",
        "quickjs-emscripten-core",
        "@jitl/quickjs-wasmfile-release-sync",
        "undici",
        "zod",
        "@electron-forge/*",
        "@reforged/maker-appimage",
        "@ramu/web",
        "babel-plugin-react-compiler",
        "@dagrejs/dagre",
        "chart.js",
        "esbuild",
        "react",
        "react-dom",
        "ws",
        "three"
      ]
    },
    "apps/mobile": {
      "ignoreBinaries": ["eas"],
      "ignoreDependencies": ["expo-updates", "escape-string-regexp"],
      "entry": ["plugins/*.cjs", "src/runtime/isomorphicWebcrypto.ts"]
    },
    "apps/server": {
      "ignoreBinaries": ["osascript", "ssh-keygen", "ffprobe"],
      "ignoreDependencies": ["@dagrejs/dagre", "chart.js", "react", "react-dom"]
    }
  },
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"],
    "apps/site/src/components/ui/**": ["exports", "types"]
  }
}
