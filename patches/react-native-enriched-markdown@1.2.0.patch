     codeAttributes[@"BlockLineHeight"] = @(UIFontLineHeight(blockFont));
 
     [output setAttributes:codeAttributes range:range];
+
+    // Ramu: room on both sides of inline code, as the desktop pads it. Kerning the character before the code and the
+    // code's last character moves the neighbours away; CodeBackground widens the chip into the room on the left, and
+    // the last character's kern already sits inside the chip on the right.
+    if (range.location > 0) {
+      [output addAttribute:NSKernAttributeName value:@(kInlineCodePadding) range:NSMakeRange(range.location - 1, 1)];
+    }
+    [output addAttribute:NSKernAttributeName value:@(kInlineCodePadding) range:NSMakeRange(NSMaxRange(range) - 1, 1)];
   }
 }
 
