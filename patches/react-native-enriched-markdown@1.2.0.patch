+/// A non-editable text view keeps its selection until something inside it is tapped, so a
+/// selection in one message stayed lit (with its handles) while the person tapped or selected
+/// elsewhere. One recognizer per window, which never claims the touch, clears every other view's
+/// selection when a tap or a new long press lands outside it.
+- (void)didMoveToWindow
+{
+  [super didMoveToWindow];
+  if (self.window)
+    ENRMTrackSelectableTextView(self);
+}
