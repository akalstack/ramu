diff --git a/ios/views/ENRMMarkdownTextView.m b/ios/views/ENRMMarkdownTextView.m
index c790eb1896c04ee40456649a8b375558ad7a09f3..8a5ec2fc2ceade787d2a2e7257b1d4af4df69d72 100644
--- a/ios/views/ENRMMarkdownTextView.m
