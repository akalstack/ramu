+// Bridge the library's native ScrollViewMarker to legacy Stack screens.
+// Registration happens after the marked scroll view mounts, so toolbar views
+// and React wrappers cannot obscure UIKit's content-scroll-view discovery.
+- (void)registerDescendantScrollView:(UIScrollView *)scrollView fromMarker:(RNSScrollViewMarkerComponentView *)marker
+{
+  if (@available(iOS 15.0, *)) {
+    [_controller setContentScrollView:scrollView forEdge:NSDirectionalRectEdgeTop];
+  }
+}
