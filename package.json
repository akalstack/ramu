{
  "name": "ramu-monorepo",
  "version": "0.1.0-alpha.8",
  "private": true,
  "description": "An open-source workspace for coding with agents, on desktop and mobile.",
  "license": "MIT",
  "author": "Ramu contributors",
  "homepage": "https://getramu.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akalstack/ramu.git"
  },
  "bugs": {
    "url": "https://github.com/akalstack/ramu/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ramu/desktop dev",
    "dev:server": "pnpm --filter @ramu/server dev",
    "dev:site": "pnpm --filter @ramu/site dev",
    "build:site": "pnpm --filter @ramu/site build",
    "dev:mobile": "pnpm --filter @ramu/mobile dev",
    "dev:mobile:tunnel": "pnpm --filter @ramu/mobile dev --tunnel",
    "build": "pnpm --filter @ramu/desktop build && pnpm --filter @ramu/server build",
    "start": "pnpm --filter @ramu/desktop start",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r test",
    "postinstall": "node scripts/postinstall.mjs",
    "package": "node scripts/release/desktop-package.mjs package",
    "make": "node scripts/release/desktop-package.mjs make",
    "ui:add": "pnpm --filter @ramu/web ui:add",
    "server": "node apps/server/dist/cli.js",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build",
    "test:scripts": "node --test scripts/release/release.test.mjs",
    "release:prepare": "node scripts/release/release.mjs prepare",
    "release:draft": "node scripts/release/release.mjs draft",
    "release:verify": "node scripts/release/release.mjs verify",
    "release:assets": "node scripts/release/release.mjs assets",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "knip": "knip",
    "test:desktop-smoke": "node --test --test-timeout=60000 scripts/smoke/desktop-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "catalog:",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "enriched-markdown": {
    "enableMath": false
  }
}
