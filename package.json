{
  "name": "ramu",
  "version": "0.0.1",
  "private": true,
  "description": "Ramu — your project, every repo, one workspace.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "ui:add": "shadcn add",
    "test:e2e": "node scripts/automation-smoke.mjs",
    "test:terminal": "node scripts/terminal-smoke.mjs",
    "icons": "electron scripts/render-icon.cjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build",
    "test:scripts": "node --test scripts/release.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:draft": "node scripts/release.mjs draft",
    "release:verify": "node scripts/release.mjs verify",
    "release:assets": "node scripts/release.mjs assets"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "lucide-react": "1.54.0",
    "monaco-editor": "0.57.0",
    "playwright-core": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "^1.18.35",
    "luxon": "^3.7.2",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "typescript-language-server": "^6.0.1",
    "zod": "4.6.5"
  },
  "productName": "Ramu",
  "author": "Ramu contributors",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  }
}
